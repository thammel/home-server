# Copy to .env and adjust. All values are optional.

# Host port the app is published on.
PORT=8000

# Timezone (affects log timestamps and backup file dates).
TZ=Europe/Berlin

# Initial admin, only used on the very first start (empty database).
# Without ADMIN_PASSWORD the admin starts with "changeme" and must change it at first login.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Set to true once the app is served over HTTPS (reverse proxy), so the login cookie is HTTPS-only.
COOKIE_SECURE=false

# Days a login stays valid without use.
SESSION_TTL_DAYS=30

# Daily SQLite backups kept in the data volume (/data/backups). 0 disables.
BACKUP_KEEP=14

# Failed logins allowed per client+name within the window before a temporary block.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Behind a reverse proxy: trust its X-Forwarded-For header (proxy's IP, or * if only the proxy can reach the app).
# FORWARDED_ALLOW_IPS=*

# Bank import over FinTS (German banks). Off while unset.
# Register a product ID with Die Deutsche Kreditwirtschaft: https://www.hbci-zka.de/register/prod_register.htm
# FINTS_PRODUCT_ID=0123456789ABCDEF0123456789

# Receipt scanning: a vision model behind an OpenAI-compatible chat completions API.
# Off unless URL and model are set. Receipt photos are sent to this URL.
# Local Ollama:   RECEIPT_SCANNER_URL=http://<host>:11434/v1  (no key)
# Hosted service: its base URL ending in /v1 and an API key.
# RECEIPT_SCANNER_URL=
# RECEIPT_SCANNER_MODEL=
# RECEIPT_SCANNER_KEY=
# Optional JSON object merged into every request, e.g. {"reasoning_effort": "low"}
# RECEIPT_SCANNER_EXTRA=
# Largest accepted upload in bytes (default 15 MB).
# RECEIPT_MAX_BYTES=15728640
